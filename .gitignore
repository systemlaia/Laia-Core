# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env

# Logs / runtime
*.log
logs/
tmp/
.temp/

# LAIA generated archive artifacts
archive/catalog/
archive/reports/
archive/manifests/
archive/evidence/
archive/tmp/
archive/**/*.sqlite
archive/**/*.sqlite3
archive/**/*.db

# Obsidian volatile workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian cache-ish / local-only state
.trash/
.obsidian/cache/
.obsidian/plugins/*/data.json.tmp

# Common temporary files
*.tmp
*.swp
~$*

# Local-only / experimental service work
services/
scripts/laia-comfy-start.sh
scripts/laia_manifest/catalog_search.py

# LAIA generated NAS manifests
archive/nas_manifests/*.csv
archive/nas_manifests/*.json
archive/nas_manifests/*.md

# Allow LAIA OpenClaw service architecture
!services/
!services/openclaw/
!services/openclaw/**
